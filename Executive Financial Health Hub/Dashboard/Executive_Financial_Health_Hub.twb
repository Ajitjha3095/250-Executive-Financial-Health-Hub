      <column caption='Size N' datatype='integer' name='[Calculation_0262839719448576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Respondent_ID])' />
      </column>
      <column caption='Savings Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0262839719796737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Monthly_Savings_INR])/SUM([Monthly_Income_INR])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0262839720787970]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 26 THEN &quot;Gen Z (&lt;26)&quot;&#13;&#10;ELSEIF [Age] &gt;= 26 AND [Age] &lt;= 41 THEN &quot;Millennials (26-41)&quot;&#13;&#10;ELSEIF [Age] &gt;= 42 AND [Age] &lt;= 57 THEN &quot;Gen X (42-57)&quot;&#13;&#10;ELSEIF [Age] &gt; 57 THEN &quot;Boomers (&gt;57)&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Income Group Short' datatype='string' name='[Calculation_0262839721000963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Income_Group] = &quot;Low Income (&lt;3L INR)&quot; THEN &quot;Low Income&quot;&#13;&#10;ELSEIF [Income_Group] = &quot;Lower-Middle (3L-8L INR)&quot; THEN &quot;Lower-Middle&quot;&#13;&#10;ELSEIF [Income_Group] = &quot;Middle Income (8L-15L INR)&quot; THEN &quot;Middle Income&quot;&#13;&#10;ELSEIF [Income_Group] = &quot;Upper-Middle (15L-30L INR)&quot; THEN &quot;Upper-Middle&quot;&#13;&#10;ELSEIF [Income_Group] = &quot;High Income (&gt;30L INR)&quot; THEN &quot;High Income&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
